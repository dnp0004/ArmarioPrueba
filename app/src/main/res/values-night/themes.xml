<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ArmarioCamara" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="android:datePickerStyle">@style/MyDatePickerStyle.Dark</item>
    </style>

    <!-- Estilo para DatePickerDialog en modo oscuro -->
    <style name="MyDatePickerStyle.Dark" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/primary_dark</item>
        <item name="android:calendarTextColor">@color/white</item>
        <item name="android:dayOfWeekBackground">@color/primary</item>
        <item name="android:dayOfWeekTextAppearance">@style/MyDatePicker.DayOfWeek</item>
    </style>

    <style name="MyDatePicker.DayOfWeek" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>