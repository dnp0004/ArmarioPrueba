<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/midnight_black">

    <!-- TÍTULO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Elige una prenda"
        android:textColor="@color/elegant_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="15dp"/>

    <!-- FILTRO -->
    <EditText
        android:id="@+id/inputFiltroSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="🔍 Buscar por nombre, color, marca..."
        android:textColor="@color/black"
        android:textColorHint="#666666"
        android:background="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <!-- RECYCLER VIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSelector"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:scrollbars="vertical"/>

    <!-- BOTÓN CANCELAR -->
    <Button
        android:id="@+id/btnCancelarSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CANCELAR"
        android:backgroundTint="#FF5722"
        android:textColor="@color/white"
        android:layout_marginTop="12dp"/>

</LinearLayout>