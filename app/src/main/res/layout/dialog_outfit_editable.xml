<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TU OUTFIT"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca cada prenda para cambiarla o eliminarla"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/containerPrendasOutfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnAddPrenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Añadir prenda"
            android:background="@color/primary"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnGuardarFavorito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar en favoritos"
            android:background="@color/accent"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnAsignarDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignar a día"
            android:background="@color/secondary"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnCompartirOutfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compartir"
            android:background="@color/tertiary"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>
