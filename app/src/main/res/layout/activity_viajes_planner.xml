<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧳 PLANIFICADOR DE VIAJES"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOMBRE DEL VIAJE"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/inputNombreViaje"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ej: Vacaciones en París"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESTINO"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/inputDestino"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ej: París, Francia"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FECHAS DEL VIAJE"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <TextView
                    android:id="@+id/txtFechaInicioViaje"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="📅 Inicio"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <TextView
                    android:id="@+id/txtFechaFinViaje"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="📅 Fin"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿CUÁNTOS OUTFITS NECESITAS?"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <SeekBar
            android:id="@+id/seekNumOutfits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="6"
            android:progress="2"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/txtNumOutfitsSeleccionados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 outfits"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnGenerarOutfitsViaje"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="✨ GENERAR OUTFITS PARA EL VIAJE"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTFITS GENERADOS"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOutfitsViaje"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnGuardarTodoViaje"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="💾 GUARDAR TODO EN EL CALENDARIO"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>