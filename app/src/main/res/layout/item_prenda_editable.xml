<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- IMAGEN 120x120 -->
        <androidx.cardview.widget.CardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgPrendaEditable"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#EEEEEE"/>
        </androidx.cardview.widget.CardView>

        <!-- NOMBRE -->
        <TextView
            android:id="@+id/txtNombrePrendaEditable"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Prenda"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"/>

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnCambiarPrendaEditable"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:text="🔄 Cambiar"
                android:textSize="12sp"
                android:backgroundTint="@color/elegant_gold"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/btnEliminarPrendaEditable"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/pinterest_red"
                android:text="❌ Quitar"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>