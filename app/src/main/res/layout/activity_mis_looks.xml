<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- HEADER -->
    <TextView
        android:id="@+id/txtTituloLooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⭐ MIS LOOKS FAVORITOS"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/txtSubtituloLooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tus conjuntos guardados"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/txtTituloLooks"/>

    <!-- LISTA DE LOOKS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/txtSubtituloLooks"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- FAB CREAR NUEVO -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCrearNuevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_input_add"
        app:tint="@color/white"
        app:backgroundTint="@color/pinterest_red"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>