<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/midnight_black"
    android:padding="24dp">

    <TextView
        android:text="ASISTENTE DE ESTILO"
        android:textColor="@color/elegant_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="¿PARA QUÉ OCASIÓN?"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Spinner
        android:id="@+id/spinnerOcasion"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:color/white"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:text="¿PREFIERES ALGÚN COLOR?"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Spinner
        android:id="@+id/spinnerColor"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:color/white"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnGenerarFinal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="✨ CREAR OUTFIT"
        android:backgroundTint="@color/elegant_gold"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>

</LinearLayout>