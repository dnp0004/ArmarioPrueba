<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTFIT AUTOMÁTICO CON IA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="20dp"/>

        <!-- OCASIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿PARA QUÉ OCASIÓN?"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerOcasion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- TEMPERATURA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿QUÉ TEMPERATURA HACE? (°C)"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTemperatura"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej: 10, 20, 30..."
            android:inputType="numberDecimal"
            android:textColor="@color/black"
            android:textColorHint="@color/text_hint"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- DURACIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿CUÁNTO TIEMPO ESTARÁS?"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerDuracion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- ACTIVIDAD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿QUÉ VAS A HACER?"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerActividad"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- CAPAS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NÚMERO DE CAPAS/PRENDAS"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtCapas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal (3-4 prendas)"
            android:textColor="@color/pinterest_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <SeekBar
            android:id="@+id/seekCapas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:progress="1"
            android:layout_marginBottom="16dp"/>

        <!-- OPCIONES ESPECIALES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONDICIONES ESPECIALES"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/checkExterior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ Estaré en exteriores"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/checkLluvia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌧️ Puede llover"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/checkFormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👔 Necesito ir formal/elegante"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/checkDeportivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃 Necesito ropa deportiva"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"/>

        <!-- BOTÓN GENERAR -->
        <Button
            android:id="@+id/btnGenerarIA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🤖 GENERAR OUTFIT"
            android:textColor="@color/white"
            android:backgroundTint="@color/pinterest_red"
            android:textStyle="bold"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>