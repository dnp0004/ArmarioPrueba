<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Directorio para fotos de prendas tomadas con la cámara -->
    <external-files-path
        name="images"
        path="Pictures/Prendas/" />

    <!-- Directorio para prendas guardadas -->
    <external-files-path
        name="prendas"
        path="prendas/" />

    <!-- Acceso a storage externo -->
    <external-path
        name="external_files"
        path="." />

    <!-- Cache para archivos temporales -->
    <cache-path
        name="cache"
        path="." />
</paths>